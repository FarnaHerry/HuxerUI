cmake_minimum_required(VERSION 3.20)

foreach (required IN ITEMS SOURCE_DIRECTORY WORK_DIRECTORY HOST_GENERATOR HOST_CXX_COMPILER)
    if (NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif ()
endforeach ()

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(root "${WORK_DIRECTORY}/huxerui-ios-link-${nonce} with spaces")
file(MAKE_DIRECTORY "${root}/source")
file(WRITE "${root}/source/empty.cpp" "int fixture() { return 0; }\n")
set(project [====[
cmake_minimum_required(VERSION 3.20)
project(IosLinkFixture LANGUAGES CXX)
include("@SOURCE_DIRECTORY@/cmake/HuxerUIApp.cmake")
foreach(name IN ITEMS app framework dependency leaf debug_dep release_dep)
    add_library(${name} STATIC empty.cpp)
endforeach()
add_library(fixture::dependency ALIAS dependency)
add_library(usage INTERFACE)
add_library(cycle_a INTERFACE)
add_library(cycle_b INTERFACE)
target_link_libraries(cycle_a INTERFACE cycle_b)
target_link_libraries(cycle_b INTERFACE cycle_a)
target_link_libraries(dependency PRIVATE leaf)
target_link_libraries(usage INTERFACE fixture::dependency
    "$<$<CONFIG:Debug>:debug_dep>" "$<$<NOT:$<CONFIG:Debug>>:release_dep>" cycle_a)
target_link_libraries(app PRIVATE framework "$<BUILD_INTERFACE:usage>" m)
target_link_options(app PRIVATE "SHELL:-framework 'Core Data'" "LINKER:SHELL:-rpath '/path with spaces'"
    "$<$<CONFIG:Debug>:-app-debug>" "$<$<NOT:$<CONFIG:Debug>>:-app-release>")
target_link_options(dependency INTERFACE "LINKER:-exported_symbol,_fixture")
target_link_options(dependency PRIVATE -must-not-propagate)
target_link_directories(usage INTERFACE "/libraries with spaces")
set(response "${CMAKE_BINARY_DIR}/huxerui-ios/app/link.rsp")
set_property(TARGET app PROPERTY HUXERUI_APP_FRAMEWORK_TARGET framework)
# Only response generation runs on this host; Apple's archive merge tool is not invoked.
set(HUXERUI_IOS_LIBTOOL "${CMAKE_COMMAND}")
_huxerui_configure_ios_app_core(app)
add_custom_target(response ALL DEPENDS app "${response}")
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/$<CONFIG>-artifacts.cmake" CONTENT
    "set(expected [==[$<TARGET_FILE:framework>;$<TARGET_FILE:dependency>;$<TARGET_FILE:leaf>;$<IF:$<CONFIG:Debug>,$<TARGET_FILE:debug_dep>,$<TARGET_FILE:release_dep>>]==])\nset(excluded [==[$<IF:$<CONFIG:Debug>,$<TARGET_FILE:release_dep>,$<TARGET_FILE:debug_dep>>]==])\n")
]====])
string(CONFIGURE "${project}" project @ONLY)
file(WRITE "${root}/source/CMakeLists.txt" "${project}")

foreach (configuration IN ITEMS Debug Release)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}/source" -B "${root}/build"
            -G "${HOST_GENERATOR}" "-DCMAKE_CXX_COMPILER=${HOST_CXX_COMPILER}"
            "-DCMAKE_BUILD_TYPE=${configuration}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if (NOT result EQUAL 0)
        message(FATAL_ERROR "iOS link fixture configure failed: ${output}${error}")
    endif ()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${root}/build" --config "${configuration}" --target response
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if (NOT result EQUAL 0)
        message(FATAL_ERROR "iOS link fixture build failed: ${output}${error}")
    endif ()
    include("${root}/build/${configuration}-artifacts.cmake")
    file(READ "${root}/build/huxerui-ios/app/link.rsp" response)
    separate_arguments(arguments UNIX_COMMAND "${response}")
    list(APPEND expected -force_load "${root}/build/huxerui-ios/app/libapp_huxerui.a" -lm -framework "Core Data"
            -Xlinker -rpath "/path with spaces" -exported_symbol _fixture "-L/libraries with spaces")
    if (configuration STREQUAL "Debug")
        list(APPEND expected -app-debug)
        list(APPEND excluded -app-release)
    else ()
        list(APPEND expected -app-release)
        list(APPEND excluded -app-debug)
    endif ()
    foreach (argument IN LISTS expected)
        if (NOT argument IN_LIST arguments)
            message(FATAL_ERROR "Missing ${configuration} link argument '${argument}':\n${response}")
        endif ()
    endforeach ()
    list(APPEND excluded dependency fixture::dependency leaf debug_dep release_dep m -must-not-propagate)
    foreach (argument IN LISTS excluded)
        if (argument IN_LIST arguments)
            message(FATAL_ERROR "Unexpected ${configuration} link argument '${argument}':\n${response}")
        endif ()
    endforeach ()
endforeach ()
message(STATUS "iOS response-file dependency and option checks passed for Debug and Release")
