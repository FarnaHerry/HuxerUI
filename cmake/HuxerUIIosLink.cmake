include_guard(GLOBAL)
cmake_policy(PUSH)
cmake_policy(VERSION 3.20)

function(_huxerui_ios_quote value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_huxerui_ios_collect_links name stack libraries_output options_output)
    string(SHA256 key "${name}")
    set(id "${ios_alias_${key}}")
    set(libraries)
    set(options)
    if (id)
        if (ios_${id}_file AND NOT name STREQUAL ios_root)
            _huxerui_ios_quote("${ios_${id}_file}" argument)
            list(APPEND libraries "${argument}")
        endif ()
        if (NOT id IN_LIST stack)
            list(APPEND stack "${id}")
            list(APPEND options ${ios_${id}_options})
            foreach (directory IN LISTS ios_${id}_directories)
                list(APPEND options "-L${directory}")
            endforeach ()
            foreach (link IN LISTS ios_${id}_links)
                _huxerui_ios_collect_links("${link}" "${stack}" child_libraries child_options)
                list(APPEND libraries ${child_libraries})
                list(APPEND options ${child_options})
            endforeach ()
        endif ()
    elseif (name STREQUAL "" OR name MATCHES "^::@")
        # CMake uses directory markers around cross-directory target references.
    elseif (name MATCHES "^-")
        separate_arguments(arguments UNIX_COMMAND "${name}")
        foreach (argument IN LISTS arguments)
            _huxerui_ios_quote("${argument}" argument)
            list(APPEND libraries "${argument}")
        endforeach ()
    elseif (IS_ABSOLUTE "${name}" OR name MATCHES "[/\\]")
        _huxerui_ios_quote("${name}" argument)
        list(APPEND libraries "${argument}")
    elseif (name MATCHES "::|\\$<")
        message(FATAL_ERROR "HuxerUI cannot resolve iOS link dependency: ${name}")
    else ()
        _huxerui_ios_quote("-l${name}" argument)
        list(APPEND libraries "${argument}")
    endif ()
    set(${libraries_output} "${libraries}" PARENT_SCOPE)
    set(${options_output} "${options}" PARENT_SCOPE)
endfunction()

function(_huxerui_ios_write_link_response)
    include("${HUXERUI_IOS_LINK_MANIFEST}")
    _huxerui_ios_collect_links("${ios_root}" "" libraries options)
    _huxerui_ios_quote("${ios_core}" core)
    set(content "-force_load\n${core}\n")
    list(REMOVE_DUPLICATES options)
    foreach (option IN LISTS options)
        set(linker FALSE)
        if (option MATCHES "^LINKER:(.*)$")
            set(linker TRUE)
            set(option "${CMAKE_MATCH_1}")
        endif ()
        if (option MATCHES "^SHELL:(.*)$")
            separate_arguments(arguments UNIX_COMMAND "${CMAKE_MATCH_1}")
        elseif (linker)
            string(REPLACE "," ";" arguments "${option}")
        else ()
            set(arguments "${option}")
        endif ()
        foreach (argument IN LISTS arguments)
            if (linker)
                string(APPEND content "-Xlinker\n")
            endif ()
            _huxerui_ios_quote("${argument}" argument)
            string(APPEND content "${argument}\n")
        endforeach ()
    endforeach ()
    foreach (argument IN LISTS libraries)
        string(APPEND content "${argument}\n")
    endforeach ()
    file(WRITE "${ios_response}" "${content}")
endfunction()

if (CMAKE_SCRIPT_MODE_FILE AND DEFINED HUXERUI_IOS_LINK_MANIFEST)
    _huxerui_ios_write_link_response()
    cmake_policy(POP)
    return()
endif ()

function(_huxerui_generate_ios_link_manifest target_name core response output)
    set(pending "${target_name}")
    set(visited)
    set(content "set(ios_root [==[${target_name}]==])\nset(ios_core [==[${core}]==])\n")
    string(APPEND content "set(ios_response [==[${response}]==])\n")
    while (pending)
        list(POP_FRONT pending name)
        get_target_property(alias "${name}" ALIASED_TARGET)
        if (alias)
            set(canonical "${alias}")
        else ()
            set(canonical "${name}")
        endif ()
        string(SHA256 key "${name}")
        string(SHA256 id "${canonical}")
        string(APPEND content "set(ios_alias_${key} ${id})\n")
        if (canonical IN_LIST visited)
            continue()
        endif ()
        list(APPEND visited "${canonical}")
        string(APPEND content "set(ios_alias_${id} ${id})\n")
        get_target_property(kind "${canonical}" TYPE)
        if (kind MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|UNKNOWN_LIBRARY|MODULE_LIBRARY)$")
            string(APPEND content "set(ios_${id}_file [==[$<TARGET_FILE:${canonical}>]==])\n")
        endif ()
        foreach (entry IN ITEMS links options directories)
            if (entry STREQUAL "links")
                set(properties INTERFACE_LINK_LIBRARIES)
                if (canonical STREQUAL target_name OR kind STREQUAL "STATIC_LIBRARY")
                    list(PREPEND properties LINK_LIBRARIES)
                endif ()
            elseif (entry STREQUAL "options")
                set(properties INTERFACE_LINK_OPTIONS)
                if (canonical STREQUAL target_name)
                    list(PREPEND properties LINK_OPTIONS)
                endif ()
            else ()
                set(properties INTERFACE_LINK_DIRECTORIES)
                if (canonical STREQUAL target_name)
                    list(PREPEND properties LINK_DIRECTORIES)
                endif ()
            endif ()
            set(values)
            foreach (property IN LISTS properties)
                get_property(value TARGET "${canonical}" PROPERTY "${property}")
                list(APPEND values ${value})
            endforeach ()
            if (entry STREQUAL "links")
                # Discover both branches without selecting a configuration during configure.
                # CMake evaluates the actual edge list below before the build-time traversal.
                string(REGEX MATCHALL "[A-Za-z0-9_.+-]+(::[A-Za-z0-9_.+-]+)*" candidates "${values}")
                foreach (candidate IN LISTS candidates)
                    if (TARGET "${candidate}")
                        list(APPEND pending "${candidate}")
                    endif ()
                endforeach ()
            endif ()
            string(REPLACE "$<LINK_ONLY:" "$<1:" values "${values}")
            string(APPEND content
                    "set(ios_${id}_${entry} [==[$<TARGET_GENEX_EVAL:${target_name},${values}>]==])\n")
        endforeach ()
    endwhile ()
    set(manifest "${CMAKE_CURRENT_BINARY_DIR}/huxerui-ios/${target_name}/$<CONFIG>/links.cmake")
    file(GENERATE OUTPUT "${manifest}" CONTENT "${content}" TARGET ${target_name})
    set(${output} "${manifest}" PARENT_SCOPE)
endfunction()

cmake_policy(POP)
